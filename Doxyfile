# Doxygen configuration for hwshqtb::metaobject
# Usage:  doxygen Doxyfile        (run from the repository root; doxygen must be on PATH)
#
# The library is header-driven (the meta-object tables are built by consteval
# code in the headers), so `include/` is the documentation source. `src/` and
# `tests/` are deliberately not input: the former is implementation plumbing,
# the latter is not API.
#
# C++26 notes: the sources use reflection (`^^T`, `typename[: r :]`,
# `template for`) and reflection attributes (`[[= make_property(...)]]`).
# Doxygen does not model those constructs; the settings below keep it from
# tripping over them rather than trying to expand them.

PROJECT_NAME           = "MyEngine"
PROJECT_BRIEF          = "A C++26 reflection-driven rewrite of Qt, in namespace hwshqtb"
PROJECT_NUMBER         = 0.1
OUTPUT_DIRECTORY       = doc/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
FULL_PATH_NAMES        = NO
# Paths are stripped RELATIVE to the directory doxygen runs in (the repository root), so this file
# carries no machine-specific absolute path: a clone anywhere produces the same documentation.
STRIP_FROM_PATH        = . include docs
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SIP_SUPPORT            = NO
IDL_PROPERTY_SUPPORT   = YES
DISTRIBUTE_GROUP_DOC   = NO
SUBGROUPING            = YES
TYPEDEF_HIDES_STRUCT   = NO
LOOKUP_CACHE_SIZE      = 0

